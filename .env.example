# Studio24 Atelier - Environment Configuration Template
# Configure these variables in your Vercel Project Settings > Environment Variables

# Public Base URL (e.g. https://staging.studio24byshreya.com or your Vercel URL)
NEXT_PUBLIC_BASE_URL=https://staging.studio24byshreya.com

# Supabase Public API (Accessible by browser and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (SERVER-SIDE ONLY - Privileged access for admin routes and email hooks)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin Authentication Whitelist (Comma-separated emails allowed to log into /admin)
ADMIN_ALLOWED_EMAILS=amandangi950@gmail.com

# SMTP Email Dispatch (For instant lead notifications upon consultation booking)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hey@thetalkingstage.life
SMTP_PASS=your-smtp-password
MAIL_FROM=hey@thetalkingstage.life
